rules_version = '2';

// Jêga access tree (free Spark plan: no Cloud Functions, so these rules are the backend)
//   driver / host  -> phone account. The app signs in with a phone-derived email
//                     p9647XXXXXXXXX@users.jega.app (phone-only login, no code, as the owner chose)
//   admin          -> email account with custom claim admin == true (set by functions/scripts/make-admin.mjs
//                     or `firebase auth:import`, never by the app)
// Bookings are written by the app inside a transaction; every price, time and overlap check
// the old createBooking function did is enforced here instead.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.get('admin', false) == true; }
    function isUser() {
      return signedIn() && !isAdmin() && request.auth.token.get('email', '') is string
        && request.auth.token.email.matches('^p9647[0-9]{9}@users[.]jega[.]app$');
    }
    function me() { return request.auth.uid; }
    function userPath() { return /databases/$(database)/documents/users/$(me()); }
    function notBlocked() { return exists(userPath()) && get(userPath()).data.blocked != true; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------- booking maths ----------
    // A slot's day is a 24-bit number: bit h is set while hour h is booked.
    function maskOf(start, hours) { return int(math.pow(2, hours) - 1) * int(math.pow(2, start)); }
    function bitsIn(taken, start, hours) { return int(math.floor(taken / math.pow(2, start))) % int(math.pow(2, hours)); }
    function dayPath(slotId, date) { return /databases/$(database)/documents/slotDays/$(slotId + '_' + date); }
    function bookingPath(id) { return /databases/$(database)/documents/bookings/$(id); }
    function cfgPct() {
      return exists(/databases/$(database)/documents/config/app) ? get(/databases/$(database)/documents/config/app).data.get('commissionPct', 10) : 10;
    }
    function openH(t) { return int(t.split(':')[0]) + (int(t.split(':')[1]) > 0 ? 1 : 0); }
    function closeH(t) { return t == '00:00' ? 24 : int(t.split(':')[0]); }
    // Booking times are Erbil local time (UTC+3, no daylight saving)
    function startTs(date, start) {
      let p = date.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) - duration.value(3, 'h') + duration.value(start, 'h');
    }

    // ---------- app config (commission, announcement) ----------
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- users ----------
    function validName(n) { return n is string && n.size() >= 2 && n.size() <= 40; }
    match /users/{uid} {
      allow read: if (isUser() && me() == uid) || isAdmin();
      // first sign-in: the profile must belong to the phone number the account was made for
      allow create: if isUser() && me() == uid
        && request.resource.data.keys().hasOnly(['phone', 'phonePretty', 'name', 'lang', 'blocked', 'fcmTokens', 'notifyPush', 'createdAt', 'lastLoginAt'])
        && request.resource.data.blocked == false
        && request.resource.data.phone is string
        && request.auth.token.email == 'p' + request.resource.data.phone.replace('[+]', '') + '@users.jega.app'
        && validName(request.resource.data.name);
      allow update: if isUser() && me() == uid
        && onlyChanges(['name', 'lang', 'fcmTokens', 'notifyPush', 'updatedAt', 'lastLoginAt'])
        && validName(request.resource.data.name);
      allow update, delete: if isAdmin();

      match /notifications/{nid} {
        allow read: if (isUser() && me() == uid) || isAdmin();
        allow update: if isUser() && me() == uid && onlyChanges(['read']);
        allow delete: if isUser() && me() == uid;
        allow create: if isAdmin() || (isUser() && notBlocked() && userNotif(uid));
      }
    }
    // A driver may notify themself or the host, only about their own booking.
    function userNotif(uid) {
      let d = request.resource.data;
      let b = getAfter(bookingPath(d.bookingId)).data;
      return d.keys().hasOnly(['type', 'vars', 'link', 'priority', 'read', 'at', 'from', 'bookingId'])
        && d.type in ['booking_new', 'booking_confirmed', 'booking_cancelled']
        && d.read == false && d.from == me() && d.at == request.time
        && d.vars is map && d.vars.size() <= 10 && d.link is string && d.link.size() <= 200
        && b.driverUid == me() && (uid == b.hostUid || uid == me());
    }

    // ---------- parking slots ----------
    function validSlot(d) {
      return d.title is string && d.title.size() >= 4 && d.title.size() <= 60
        && d.landmark is string && d.landmark.size() <= 120
        && d.area is string
        && d.mode in ['hour', 'flat']
        && d.price is int && d.price >= 250 && d.price <= 10000000
        && d.maxH is int && d.maxH >= 1 && d.maxH <= 24
        && d.lat is number && d.lng is number
        && d.feat is list && d.feat.size() <= 10
        && d.allDay is bool && d.opens.matches('^[0-2][0-9]:[0-5][0-9]$') && d.closes.matches('^[0-2][0-9]:[0-5][0-9]$');
    }
    match /slots/{slotId} {
      allow read: if signedIn();
      allow create: if isUser() && notBlocked()
        && request.resource.data.hostUid == me()
        && request.resource.data.status == 'active'
        && validSlot(request.resource.data);
      // hosts can edit and hide/show (active) but never change status (set by admin) or owner
      allow update: if isUser() && notBlocked() && resource.data.hostUid == me()
        && request.resource.data.hostUid == me()
        && request.resource.data.status == resource.data.status
        && validSlot(request.resource.data);
      allow delete: if isUser() && resource.data.hostUid == me();
      allow write: if isAdmin();
    }

    // ---------- which hours of a slot are taken, per day ----------
    match /slotDays/{dayId} {
      allow read: if signedIn();
      allow create: if isUser() && notBlocked() && dayBook(dayId, 0);
      allow update: if (isUser() && notBlocked() && dayBook(dayId, resource.data.taken)) || dayRelease(dayId);
    }
    // a new booking marks its hours; they must all have been free
    function dayBook(dayId, before) {
      let d = request.resource.data;
      let b = getAfter(bookingPath(d.lastBooking)).data;
      return d.keys().hasOnly(['slotId', 'date', 'taken', 'lastBooking'])
        && !exists(bookingPath(d.lastBooking)) && b.driverUid == me()
        && dayId == b.slotId + '_' + b.date && d.slotId == b.slotId && d.date == b.date
        && bitsIn(before, b.start, b.hours) == 0
        && d.taken == before + maskOf(b.start, b.hours);
    }
    // a cancelled booking frees exactly its hours, once
    function dayRelease(dayId) {
      let d = request.resource.data;
      let b0 = get(bookingPath(d.lastBooking)).data;
      let b1 = getAfter(bookingPath(d.lastBooking)).data;
      return signedIn() && (isAdmin() || b0.driverUid == me())
        && d.keys().hasOnly(['slotId', 'date', 'taken', 'lastBooking'])
        && d.slotId == resource.data.slotId && d.date == resource.data.date
        && dayId == b0.slotId + '_' + b0.date
        && b0.status == 'confirmed' && b1.status == 'cancelled'
        && bitsIn(resource.data.taken, b0.start, b0.hours) == int(math.pow(2, b0.hours)) - 1
        && d.taken == resource.data.taken - maskOf(b0.start, b0.hours);
    }

    // ---------- bookings ----------
    function validBooking(id) {
      let b = request.resource.data;
      let s = get(/databases/$(database)/documents/slots/$(b.slotId)).data;
      let u = get(userPath()).data;
      let t0 = startTs(b.date, b.start);
      let feeDiff = b.platformFee * 100 - b.total * cfgPct();
      return b.keys().hasOnly(['slotId', 'slotCode', 'slotTitle', 'landmark', 'lat', 'lng', 'hostUid', 'hostName', 'hostPhone',
          'driverUid', 'driverName', 'driverPhone', 'date', 'start', 'hours', 'mode', 'unitPrice', 'total', 'platformFee',
          'hostEarning', 'payMethod', 'status', 'paymentStatus', 'startAt', 'endAt', 'createdAt'])
        && b.driverUid == me() && b.driverName == u.name && b.driverPhone == u.phonePretty
        && b.date is string && b.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && b.start is int && b.hours is int && b.start >= 0 && b.hours >= 1 && b.start + b.hours <= 24
        && s.status == 'active' && s.active == true && s.hostUid != me()
        && b.hostUid == s.hostUid && b.hostName == s.hostName && b.hostPhone == s.hostPhone
        && b.slotCode == s.code && b.mode == s.mode && b.unitPrice == s.price
        && b.hours <= s.maxH
        && (s.allDay == true || (b.start >= openH(s.opens) && b.start + b.hours <= closeH(s.closes)))
        && b.total == (s.mode == 'flat' ? s.price : s.price * b.hours)
        && b.platformFee is int && feeDiff <= 50 && feeDiff >= -50 && b.hostEarning == b.total - b.platformFee
        && b.payMethod == 'cash' && b.status == 'confirmed' && b.paymentStatus == 'cash_on_arrival'
        && b.startAt == t0 && b.endAt == t0 + duration.value(b.hours, 'h')
        && b.endAt > request.time && b.startAt < request.time + duration.value(744, 'h')
        && b.createdAt == request.time
        && getAfter(dayPath(b.slotId, b.date)).data.lastBooking == id;
    }
    // the driver cancels before the start; the same write must free the hours
    function driverCancel() {
      let b = resource.data;
      let n = request.resource.data;
      return b.driverUid == me() && b.status == 'confirmed' && b.startAt > request.time
        && n.status == 'cancelled' && n.cancelledBy == 'driver' && n.cancelledAt == request.time
        && onlyChanges(['status', 'cancelledBy', 'cancelledAt'])
        && getAfter(dayPath(b.slotId, b.date)).data.taken == get(dayPath(b.slotId, b.date)).data.taken - maskOf(b.start, b.hours);
    }
    match /bookings/{bookingId} {
      allow read: if (isUser() && (resource.data.driverUid == me() || resource.data.hostUid == me())) || isAdmin();
      allow create: if isUser() && notBlocked() && validBooking(bookingId);
      allow update: if (isUser() && driverCancel())
        || (isAdmin() && onlyChanges(['status', 'cancelledBy', 'cancelReason', 'cancelledAt', 'refund', 'refundNote', 'refundedAt']));
      allow delete: if false;
    }

    // ---------- payments (online payments need the Blaze plan; read-only history) ----------
    match /payments/{paymentId} {
      allow read: if (isUser() && resource.data.driverUid == me()) || isAdmin();
      allow write: if false;
    }

    // ---------- chat ----------
    function chatPath(id) { return /databases/$(database)/documents/chats/$(id); }
    match /chats/{chatId} {
      // `resource == null` lets the app check whether a thread exists before creating it
      allow get: if (isUser() && (resource == null || me() in resource.data.members)) || isAdmin();
      allow list: if (isUser() && me() in resource.data.members) || isAdmin();
      allow create: if isUser() && notBlocked()
        && me() in request.resource.data.members
        && request.resource.data.members.size() == 2
        && request.resource.data.keys().hasOnly(['members', 'slotId', 'slotCode', 'names', 'lastAt', 'lastText', 'lastFrom', 'unread']);
      // members keep the thread summary and unread counters up to date
      allow update: if isUser() && me() in resource.data.members
        && request.resource.data.members == resource.data.members
        && onlyChanges(['unread', 'lastText', 'lastFrom', 'lastAt', 'names']);

      match /messages/{mid} {
        allow read: if (isUser() && me() in get(chatPath(chatId)).data.members) || isAdmin();
        allow create: if isUser() && notBlocked()
          && me() in getAfter(chatPath(chatId)).data.members
          && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'type', 'bookingId'])
          && request.resource.data.from == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        allow update, delete: if isAdmin();
      }
    }

    // ---------- reports from users ----------
    match /reports/{rid} {
      allow create: if isUser() && notBlocked() && request.resource.data.by == me()
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if isAdmin();
    }

    // ---------- admin alerts (the app raises new_slot and report alerts) ----------
    match /alerts/{aid} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (isUser() && notBlocked()
        && request.resource.data.keys().hasOnly(['type', 'severity', 'data', 'resolved', 'at'])
        && request.resource.data.type in ['new_slot', 'report']
        && request.resource.data.severity in ['info', 'warning']
        && request.resource.data.resolved == false
        && request.resource.data.data is map && request.resource.data.data.size() <= 5);
    }

    // ---------- admin-only ----------
    match /broadcasts/{bid}  { allow read, write: if isAdmin(); }
    match /admins/{uid}      { allow read, write: if isAdmin() && me() == uid; }
    match /auditLog/{id}     { allow read: if isAdmin(); allow create: if isAdmin(); }
    match /rateLimits/{id}   { allow read, write: if false; }
  }
}
