# Public settings for Cloud Functions. Secrets (API key, webhook secret) are NOT stored here:
#   firebase functions:secrets:set FURATPAY_API_KEY        (enter: none   until you have a FuratPay account)
#   firebase functions:secrets:set FURATPAY_WEBHOOK_SECRET (enter: none   until you have a FuratPay account)

# Where the Jêga app is hosted (used to send drivers back after paying)
APP_URL=https://your-project-id.web.app

# FuratPay API base URL (from your FuratPay dashboard)
FURATPAY_API_URL=https://api.furatpay.com/v1

# Optional: a fixed FuratPay customer id. Leave empty so each driver becomes their own FuratPay customer.
FURATPAY_CUSTOMER_ID=

# Optional: if FuratPay requires a customer email, drivers get <uid>@<this domain>
FURATPAY_CUSTOMER_EMAIL_DOMAIN=
